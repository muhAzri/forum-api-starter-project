# HTTP SERVER
HOST=0.0.0.0
PORT=5000

# POSTGRES
# When running via docker-compose, PGHOST must match the db service name ("db")
PGHOST=db
PGUSER=developer
PGDATABASE=forumapi
PGPASSWORD=supersecretpassword
PGPORT=5432

# TOKENIZE
ACCESS_TOKEN_KEY=change-me
REFRESH_TOKEN_KEY=change-me
ACCESS_TOKEN_AGE=3000

# Set NODE_ENV=production on the server
NODE_ENV=production
